    interval: 300
    tolerance: 50
    hidden: true
    icon: https://raw.githubusercontent.com/Rabbit-Spec/Surge/Master/Conf/icon/Country-Singapore.png

  # > 机场整体手动选择（可单独锁定某个机场的某个节点）
  - name: "✈️ 机场A"
    type: select
