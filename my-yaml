    interval: 300
    tolerance: 50
    hidden: true
    icon: https://raw.githubusercontent.com/Rabbit-Spec/Surge/Master/Conf/icon/Country-Japan.png

  - name: "🇰🇷 韩国节点"
    type: url-test
    use: ["机场A", "机场B"]
    filter: "(?i)(🇰🇷|韩国|Korea|\\bKR)"
    url: https://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
    hidden: true
    icon: https://raw.githubusercontent.com/Rabbit-Spec/Surge/Master/Conf/icon/Country-South_Korea.png

  - name: "🇹🇼 台湾节点"
    type: url-test
    use: ["机场A", "机场B"]
    filter: "(?i)(🇹🇼|🇨🇳|台湾|Tai|TW)"
    url: https://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
    hidden: true
    icon: https://raw.githubusercontent.com/Rabbit-Spec/Surge/Master/Conf/icon/Country-China.png

  - name: "🇸🇬 新加坡节点"
    type: url-test
    use: ["机场A", "机场B"]
    filter: "(?i)(🇸🇬|新加坡|Singapore|SG)"
