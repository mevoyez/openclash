  # > 地区节点组（合并两个机场的节点，自动测速选最快，对应 Surge 的 smart 组）
  - name: "🇭🇰 香港节点"
    type: url-test
    use: ["机场A", "机场B"]
    filter: "(?i)(🇭🇰|香港|Hong|HK)"
    url: https://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
    hidden: true
    icon: https://raw.githubusercontent.com/Rabbit-Spec/Surge/Master/Conf/icon/Country-Hong_Kong.png

  - name: "🇺🇸 美国节点"
    type: url-test
    use: ["机场A", "机场B"]
    filter: "(?i)(🇺🇸|美国|States|US)"
    url: https://www.gstatic.com/generate_204
    interval: 300
    tolerance: 50
    hidden: true
    icon: https://raw.githubusercontent.com/Rabbit-Spec/Surge/Master/Conf/icon/Country-United_States.png

  - name: "🇯🇵 日本节点"
