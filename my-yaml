# ============================================================
# OpenClash (Mihomo 内核) 双机场配置 —— 参照 Rabbit-Spec Surge 配置改写
# 使用前：把两个 proxy-providers 里的 url 换成你的两个订阅地址
#
# 结构说明：
#   机场A / 机场B 各自一个订阅，节点名自动加前缀 [A] / [B] 以避免重名
#   各地区组（香港/美国…）同时合并两个机场的节点，自动测速选最快
#   Proxy 组里可选地区组，也可直接锁定某一个机场
# ============================================================

mixed-port: 7890
allow-lan: true
bind-address: "*"
mode: rule
log-level: info
ipv6: false
unified-delay: true
tcp-concurrent: true
find-process-mode: strict
global-client-fingerprint: chrome

profile:
  store-selected: true
  store-fake-ip: true

# ---------------- DNS ----------------
dns:
  enable: true
  listen: 0.0.0.0:7874
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - "*.lan"
    - "*.local"
    - "+.msftconnecttest.com"
    - "+.msftncsi.com"
    - "time.*.com"
    - "ntp.*.com"
    - "+.pool.ntp.org"
    - "localhost.ptlogin2.qq.com"
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query
  fallback:
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query
  fallback-filter:
    geoip: true
    geoip-code: CN
    ipcidr:
      - 240.0.0.0/4
  proxy-server-nameserver:
    - https://dns.alidns.com/dns-query
    - https://doh.pub/dns-query

# ---------------- 双机场订阅 ----------------
proxy-providers:
  机场A:
    type: http
    url: "机场A的订阅地址"
    interval: 3600
    path: ./providers/airport_a.yaml
    health-check:
      enable: true
      url: https://www.gstatic.com/generate_204
      interval: 300
    override:
      udp: true
      additional-prefix: "[A] "

  机场B:
    type: http
    url: "机场B的订阅地址"
    interval: 3600
    path: ./providers/airport_b.yaml
    health-check:
      enable: true
      url: https://www.gstatic.com/generate_204
      interval: 300
    override:
      udp: true
      additional-prefix: "[B] "

# ---------------- 策略组 ----------------
proxy-groups:
